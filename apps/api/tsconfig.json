{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "target": "ES2022",
    "lib": ["ES2022"],
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "baseUrl": "..",
    "paths": {
      "@doviz/shared": ["packages/shared/src/index.ts"],
      "@doviz/shared/*": ["packages/shared/src/*"],
      "@doviz/i18n": ["packages/i18n/src/index.ts"],
      "@doviz/i18n/*": ["packages/i18n/src/*"]
    }
  },
  "include": ["src/**/*", "prisma/seed.ts"]
}